# ===========================================
# Smart Flood AI Backend - Environment Config
# ===========================================

# LINE OA Configuration
LINE_OA_TOKEN=your_line_oa_channel_access_token_here
LINE_OA_USER_ID=your_target_user_or_group_id_here
PUBLIC_BASE_URL=your_public_url_or_cloudflare_tunnel_url

# Server Configuration
# PORT=8000
# HOST=127.0.0.1

# ===========================================
# Frontend Configuration (smart-flood-dashboard/.env.local)
# ===========================================
# See smart-flood-dashboard/.env.example for the full list.
# Key variables:
NEXT_PUBLIC_API_BASE_URL=your_public_backend_url_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase (see smart-flood-dashboard/.env.example for full config)
# NEXT_PUBLIC_FIREBASE_API_KEY=...
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=...
# FIREBASE_ADMIN_PROJECT_ID=...
# FIREBASE_ADMIN_CLIENT_EMAIL=...
# FIREBASE_ADMIN_PRIVATE_KEY=...
